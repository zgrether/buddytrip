# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report

# local DB backups / snapshots (may contain test PII — never commit)
/backups

# next.js
/.next/
/out/
# Alternate build dirs via NEXT_DIST_DIR — `.next-e2e` (isolated E2E build, so a
# Playwright run can't be served a dev server's tree), `.next-measure`, and
# whatever the next one is called. A GLOB rather than another one-off entry:
# `.next-measure` had to be added after the fact, `.next-e2e` was sitting
# untracked, and one `git add -A` before the cleanup step would have committed a
# whole production build.
/.next-*/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*.local

# vercel
.vercel

# claude code local settings (may contain secrets in permission rules)
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts
.test-auth-pool.json
.test-auth.json
.claude/scheduled_tasks.lock

# Playwright auth state (session — never commit)
e2e/.auth/
.next-measure/
